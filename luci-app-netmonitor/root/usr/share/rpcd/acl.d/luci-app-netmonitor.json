{
	"luci-app-netmonitor": {
		"description": "Grant access to netmonitor traffic statistics and settings",
		"read": {
			"ubus": {
				"netmonitor": [ "status", "topology", "devices", "overview", "device_detail", "device_months", "device_month_summary", "get_config", "estimate", "check_path" ]
			},
			"uci": [ "netmonitor" ]
		},
		"write": {
			"ubus": {
				"netmonitor": [ "set_config", "collector", "prepare_path", "update_asn", "update_service" ]
			},
			"uci": [ "netmonitor" ]
		}
	}
}
