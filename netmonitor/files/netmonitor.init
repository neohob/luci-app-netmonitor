#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/netmonitor-collector

start_service() {
	config_load netmonitor
	local enabled enable_acct
	config_get_bool enabled main enabled 1
	config_get_bool enable_acct main enable_acct 1
	[ "$enabled" = "1" ] || return 0

	mkdir -p /var/run/netmonitor

	# Refuse to start until the wizard has stored a valid, writable path.
	$PROG --check >/dev/null 2>&1 || return 1

	# Re-apply dnsmasq query log wiring each start (F6 runtime health).
	local manage_dnsmasq dns_log
	config_get_bool manage_dnsmasq main manage_dnsmasq 1
	config_get dns_log main dns_log /tmp/netmonitor-dnsmasq.log
	if [ "$manage_dnsmasq" = "1" ]; then
		uci -q set dhcp.@dnsmasq[0].logqueries='1'
		uci -q set dhcp.@dnsmasq[0].logfacility="$dns_log"
		uci -q commit dhcp
		/etc/init.d/dnsmasq reload >/dev/null 2>&1 || true
	fi

	[ "$enable_acct" = "1" ] && sysctl -w net.netfilter.nf_conntrack_acct=1 >/dev/null 2>&1

	procd_open_instance
	procd_set_param command $PROG
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	$PROG --mark-stopped >/dev/null 2>&1
}

service_triggers() {
	procd_add_reload_trigger netmonitor
}
