#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/netmonitor-collector

start_service() {
	config_load netmonitor
	local enabled enable_acct
	config_get_bool enabled main enabled 1
	config_get_bool enable_acct main enable_acct 1

	mkdir -p /var/run/netmonitor

	# Always run: recover LuCI login if rpcd/session dies (procd stops
	# respawning after ~5 crashes/hour). Independent of collector enable.
	procd_open_instance rpcd_watch
	procd_set_param command /usr/sbin/netmonitor-rpcd-watch
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	[ "$enabled" = "1" ] || return 0

	# Refuse to start collector until the wizard has stored a valid path.
	$PROG --check >/dev/null 2>&1 || return 1

	# Re-apply dnsmasq query log wiring each start (F6 runtime health).
	# ImmortalWrt/iStore often ship /etc/dnsmasq.conf with log-facility=/dev/null;
	# UCI also emits log-facility → "illegal repeated keyword" and dnsmasq crash-loops,
	# leaving the collector with an empty log (all targets 「未解析」). Neutralize the
	# static file so only UCI's facility applies. Works with mosdns-as-upstream too:
	# clients still hit dnsmasq:53 first, so query/reply lines are logged here.
	local manage_dnsmasq dns_log
	config_get_bool manage_dnsmasq main manage_dnsmasq 1
	config_get dns_log main dns_log /tmp/netmonitor-dnsmasq.log
	if [ "$manage_dnsmasq" = "1" ]; then
		if [ -f /etc/dnsmasq.conf ] && grep -q '^log-facility=' /etc/dnsmasq.conf; then
			[ -f /etc/dnsmasq.conf.bak-netmonitor ] || cp -a /etc/dnsmasq.conf /etc/dnsmasq.conf.bak-netmonitor
			sed -i 's/^log-facility=.*/# log-facility disabled by netmonitor (UCI dhcp.@dnsmasq logfacility)/' /etc/dnsmasq.conf
		fi
		touch "$dns_log" 2>/dev/null || true
		uci -q set dhcp.@dnsmasq[0].logqueries='1'
		uci -q set dhcp.@dnsmasq[0].logfacility="$dns_log"
		uci -q commit dhcp
		/etc/init.d/dnsmasq restart >/dev/null 2>&1 || /etc/init.d/dnsmasq reload >/dev/null 2>&1 || true
	fi

	[ "$enable_acct" = "1" ] && sysctl -w net.netfilter.nf_conntrack_acct=1 >/dev/null 2>&1

	# Single procd instance: collector embeds DNS sniff + SNI (no cron, no extra service).
	procd_open_instance
	procd_set_param command $PROG
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	$PROG --mark-stopped >/dev/null 2>&1
}

service_triggers() {
	procd_add_reload_trigger netmonitor
}
