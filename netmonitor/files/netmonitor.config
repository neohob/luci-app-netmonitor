config netmonitor 'main'
	option enabled '1'
	option db_path ''
	option interval '5'
	option idle_gap '60'
	option retention_value '30'
	option retention_unit 'day'
	option reserve_min_mb '100'
	option reserve_pct '5'
	option lan_ifaces 'br-lan'
	option dns_log '/tmp/netmonitor-dnsmasq.log'
	option manage_dnsmasq '1'
	option enable_acct '1'
	option sni_enable '1'
	option asn_enable '1'
	option asn_auto_update '1'
	option asn_week_time '*'
	option asn_day_time '4'
	option asn_path '/overlay/netmonitor/GeoLite2-ASN.mmdb'
	option asn_url 'https://cdn.jsdelivr.net/npm/geolite2-asn/GeoLite2-ASN.mmdb.gz'
	option service_enable '1'
	option service_auto_update '1'
	option service_week_time '*'
	option service_day_time '5'
	option service_path '/overlay/netmonitor/services.map'
