#!/bin/sh

# Destination names come from dnsmasq answers (clients → dnsmasq → optional mosdns).
# Route query log to a tmpfs file the collector tails. File must live in /tmp.
[ "$(uci -q get netmonitor.main.manage_dnsmasq)" = "1" ] || exit 0

log="$(uci -q get netmonitor.main.dns_log)"
[ -n "$log" ] || log=/tmp/netmonitor-dnsmasq.log

# Avoid duplicate log-facility with packaged /etc/dnsmasq.conf (crash loop).
if [ -f /etc/dnsmasq.conf ] && grep -q '^log-facility=' /etc/dnsmasq.conf; then
	[ -f /etc/dnsmasq.conf.bak-netmonitor ] || cp -a /etc/dnsmasq.conf /etc/dnsmasq.conf.bak-netmonitor
	sed -i 's/^log-facility=.*/# log-facility disabled by netmonitor (UCI dhcp.@dnsmasq logfacility)/' /etc/dnsmasq.conf
fi

touch "$log" 2>/dev/null || true
uci -q set dhcp.@dnsmasq[0].logqueries='1'
uci -q set dhcp.@dnsmasq[0].logfacility="$log"
uci -q commit dhcp
/etc/init.d/dnsmasq restart >/dev/null 2>&1

exit 0
